{
  "name": "quartizo",
  "version": "0.12.6",
  "minKiroCrewVersion": "0.12.0",
  "displayName": "Quartizo",
  "description": "A Kiro Crew app: Quartizo",
  "author": "felipe",
  "iconPath": "ui/quartizo-icon.svg",
  "tags": [],
  "agents": [
    "agents/quartizo-notes.json"
  ],
  "skills": [
    "skills/quartizo-notes"
  ],
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/quartizo",
        "label": "Quartizo",
        "icon": "Gem",
        "iconUrl": "quartizo-icon.svg"
      }
    ]
  },
  "contributes": {
    "commands": [
      {
        "id": "ask-notes-agent",
        "title": "Ask the Quartizo notes agent",
        "subtitle": "Notes, tickets and TODOs in your Quartizo folders",
        "icon": "Gem",
        "keywords": [
          "quartizo",
          "vault",
          "notes",
          "ticket",
          "todo"
        ],
        "argument": {
          "kind": "text",
          "placeholder": "What should it do? e.g. add a ticket to fix the login redirect",
          "hint": "Uses your default Quartizo folder unless you name another."
        },
        "prompt": "Use the quartizo-notes skill. If I don't name a folder, use my default Quartizo folder.\n\nMy request: {argument}",
        "autoSend": false,
        "agent": "quartizo-notes"
      }
    ]
  },
  "backend": {
    "entryPoint": "backend/server.py",
    "port": "auto",
    "healthCheck": "/health",
    "signedPrincipal": true
  },
  "permissions": {
    "api": [
      "/apps/quartizo/api"
    ]
  }
}
