{
  "name": "quartizo",
  "version": "0.0.4",
  "minKiroCrewVersion": "0.12.0",
  "displayName": "Quartizo",
  "description": "A Kiro Crew app: Quartizo",
  "author": "felipe",
  "iconPath": "ui/quartizo-icon.svg",
  "tags": [],
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/quartizo",
        "label": "Quartizo",
        "icon": "Gem",
        "iconUrl": "quartizo-icon.svg"
      }
    ]
  },
  "backend": {
    "entryPoint": "backend/server.py",
    "port": "auto",
    "healthCheck": "/health",
    "signedPrincipal": true
  },
  "permissions": {
    "api": [
      "/apps/quartizo/api"
    ]
  }
}
